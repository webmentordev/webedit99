{
    email you@webedit99.com
    on_demand_tls {
        ask http://127.0.0.1:7780/tls-check
    }
}

(common) {
    encode zstd gzip
    request_body {
        max_size 120MB
    }
}

webedit99.com, www.webedit99.com {
    import common
    reverse_proxy 127.0.0.1:3000
}

shop.webedit99.com {
    import common
    @internal path /tls-check
    respond @internal 404
    reverse_proxy 127.0.0.1:7780
}

https:// {
    tls {
        on_demand
    }
    import common
    @blocked path /tls-check /admin/* /system/* /account/* /health
    respond @blocked 404
    reverse_proxy 127.0.0.1:7780
}